# ----------------------------------------------------------------------------
# Shared
# ----------------------------------------------------------------------------
LOG_LEVEL=info
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/ikbr_trader
REDIS_URL=redis://localhost:6379

# Telegram alerts (optional). Leave empty to disable.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_MIN_SEVERITY=info

# ----------------------------------------------------------------------------
# Shared IBKR / contract defaults
# ----------------------------------------------------------------------------
IB_SOCKET_HOST=127.0.0.1
# 4002 = IB Gateway paper, 4001 = IB Gateway live, 7497/7496 = TWS paper/live
IB_SOCKET_PORT=4002
IB_EXCHANGE=SMART
IB_CURRENCY=USD
# 1 = live, 2 = frozen, 3 = delayed, 4 = delayed frozen
IB_MARKET_DATA_TYPE=3

# ----------------------------------------------------------------------------
# Shared watchlist
# ----------------------------------------------------------------------------
WATCHLIST_SYMBOLS=CSPX,SPOL,MSFT,PZU,PEO,KGH,ALE,DNP,LPP,ETFSP500,ETFDAX,ETFBSPXPL,META,GOOGL,TSLA,AMZN,NVDA,AMD,QQQ,SPY,IWM,COIN,MSTR,PLTR,SMCI,AVGO,ARM,ORCL,CRWD,NFLX,UBER,DIS,BA,LLY,MARA,RIOT,BABA,JPM,GS,HOOD,XOM,CVX,PKN,PKO,SPL,CDR,JSW,MBK,TPE,PGE,CPS,KRU,BDX,11B,KTY,JOBY,BWXT,IRDM,AVAV,KTOS,RCAT,ONDS,EH,RKLB,ASTS,RDW,PL,LUNR,UEC,UUUU,DNN,NXE,OKLO,SMR,LEU
# Optional per-symbol contract overrides used as resolve hints/fallbacks.
# Format: SYMBOL:key=value|key=value;SYMBOL:key=value
# Supported keys: conid,secType,exchange,primaryExchange,currency
# Example for LSE ETF + WSE stock:
# WATCHLIST_CONTRACT_OVERRIDES=CSPX:conid=76023663|secType=STK|exchange=SMART|primaryExchange=LSEETF|currency=USD;PZU:conid=75960216|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN
WATCHLIST_CONTRACT_OVERRIDES=CSPX:conid=76023663|secType=STK|exchange=SMART|primaryExchange=LSEETF|currency=USD;SPOL:conid=83007903|secType=STK|exchange=SMART|primaryExchange=LSEETF|currency=GBP;MSFT:conid=272093|secType=STK|exchange=SMART|primaryExchange=NASDAQ|currency=USD;PZU:conid=75960216|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;PEO:conid=13462058|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;KGH:conid=13462029|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;ALE:conid=449543655|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;DNP:conid=280541665|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;LPP:conid=228789940|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;ETFSP500:conid=349174734|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;ETFDAX:conid=349174736|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;ETFBSPXPL:conid=541185582|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;META:conid=107113386|secType=STK|exchange=SMART|primaryExchange=NASDAQ|currency=USD;GOOGL:conid=208813719|secType=STK|exchange=SMART|primaryExchange=NASDAQ|currency=USD;TSLA:conid=76792991|secType=STK|exchange=SMART|primaryExchange=NASDAQ|currency=USD;AMZN:conid=3691937|secType=STK|exchange=SMART|primaryExchange=NASDAQ|currency=USD;NFLX:conid=15124833|secType=STK|exchange=SMART|primaryExchange=NASDAQ|currency=USD;UBER:conid=365207014|secType=STK|exchange=SMART|primaryExchange=NYSE|currency=USD;DIS:conid=6459|secType=STK|exchange=SMART|primaryExchange=NYSE|currency=USD;BA:conid=4762|secType=STK|exchange=SMART|primaryExchange=NYSE|currency=USD;LLY:conid=9160|secType=STK|exchange=SMART|primaryExchange=NYSE|currency=USD;MARA:conid=474219659|secType=STK|exchange=SMART|primaryExchange=NASDAQ|currency=USD;RIOT:conid=292830677|secType=STK|exchange=SMART|primaryExchange=NASDAQ|currency=USD;BABA:conid=166090175|secType=STK|exchange=SMART|primaryExchange=NYSE|currency=USD;JPM:conid=1520593|secType=STK|exchange=SMART|primaryExchange=NYSE|currency=USD;GS:conid=4627828|secType=STK|exchange=SMART|primaryExchange=NYSE|currency=USD;HOOD:conid=504546674|secType=STK|exchange=SMART|primaryExchange=NASDAQ|currency=USD;XOM:conid=13977|secType=STK|exchange=SMART|primaryExchange=NYSE|currency=USD;CVX:conid=5684|secType=STK|exchange=SMART|primaryExchange=NYSE|currency=USD;PKN:conid=13464812|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;PKO:conid=35146360|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;SPL:conid=17803150|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;CDR:conid=268960294|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;JSW:conid=268960337|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;MBK:conid=268960203|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;TPE:conid=268960206|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;PGE:conid=71420788|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;CPS:conid=268960182|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;KRU:conid=268960347|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;BDX:conid=268960270|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;11B:conid=301465574|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;KTY:conid=268960350|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN;JOBY:conid=507188246|secType=STK|exchange=SMART|primaryExchange=NYSE|currency=USD;BWXT:conid=196689572|secType=STK|exchange=SMART|primaryExchange=NYSE|currency=USD;IRDM:conid=69195736|secType=STK|exchange=SMART|primaryExchange=NASDAQ|currency=USD;AVAV:conid=42464367|secType=STK|exchange=SMART|primaryExchange=NASDAQ|currency=USD;KTOS:conid=68492173|secType=STK|exchange=SMART|primaryExchange=NASDAQ|currency=USD;RCAT:conid=376496231|secType=STK|exchange=SMART|primaryExchange=NASDAQ|currency=USD;ONDS:conid=455415330|secType=STK|exchange=SMART|primaryExchange=NASDAQ|currency=USD;EH:conid=394961312|secType=STK|exchange=SMART|primaryExchange=NASDAQ|currency=USD;RKLB:conid=787273575|secType=STK|exchange=SMART|primaryExchange=NASDAQ|currency=USD;ASTS:conid=480745767|secType=STK|exchange=SMART|primaryExchange=NASDAQ|currency=USD;RDW:conid=512000171|secType=STK|exchange=SMART|primaryExchange=NYSE|currency=USD;PL:conid=530906124|secType=STK|exchange=SMART|primaryExchange=NYSE|currency=USD;LUNR:conid=613910262|secType=STK|exchange=SMART|primaryExchange=NASDAQ|currency=USD;UEC:conid=37451201|secType=STK|exchange=SMART|primaryExchange=AMEX|currency=USD;UUUU:conid=137823153|secType=STK|exchange=SMART|primaryExchange=AMEX|currency=USD;DNN:conid=41983555|secType=STK|exchange=SMART|primaryExchange=AMEX|currency=USD;NXE:conid=204774537|secType=STK|exchange=SMART|primaryExchange=NYSE|currency=USD;OKLO:conid=500073396|secType=STK|exchange=SMART|primaryExchange=NYSE|currency=USD;SMR:conid=559289446|secType=STK|exchange=SMART|primaryExchange=NYSE|currency=USD;LEU:conid=168391375|secType=STK|exchange=SMART|primaryExchange=NYSE|currency=USD

# ----------------------------------------------------------------------------
# Ingestion
# ----------------------------------------------------------------------------
INGESTION_PORT=3101
INGESTION_CLIENT_ID=101
INGESTION_BACKFILL_1M_CANDLES=220
INGESTION_SIGNAL_ENGINE_BASE_URL=http://localhost:3102

# ----------------------------------------------------------------------------
# Execution engine
# ----------------------------------------------------------------------------
EXECUTION_PORT=3103
EXECUTION_CLIENT_ID=102
# Dedicated read-only contract/session/market-rule connection; choose an unused
# client ID distinct from execution, ingestion, backtest and research clients.
IB_METADATA_CLIENT_ID=119
EXECUTION_DEFAULT_TIF=DAY
EXECUTION_ORDER_TIMEOUT_MS=45000
# 0 disables auto-cancel; otherwise auto-cancel SUBMITTED/PRESUBMITTED after N ms.
EXECUTION_SUBMITTED_AUTO_CANCEL_MS=120000
# Retry once as MKT when broker rejects LMT with code=110 (min price variation).
EXECUTION_RETRY_AS_MKT_ON_CODE_110=true
# Daily realized loss kill-switch (% of starting equity). 0 disables.
EXECUTION_MAX_DAILY_LOSS_PCT=10

# ----------------------------------------------------------------------------
# Execution Security (Faza 1, ADR-001)
# ----------------------------------------------------------------------------
# Source of truth for broker environment. NEVER inferred from IB_SOCKET_PORT.
# Values: paper | live
IBKR_ENVIRONMENT=paper

# Master switch for write actions. Must be = true to place any order in live.
# /ready returns 200 with tradingEnabled=false when this is false (see ADR-001).
TRADING_ENABLED=false

# IBKR account whitelists per environment (CSV).
# Fail-closed at bootstrap when the active account is not in the whitelist
# matching IBKR_ENVIRONMENT. Enforced from PR3.
ALLOWED_PAPER_ACCOUNTS=
ALLOWED_LIVE_ACCOUNTS=

# Fastify listen host for execution-engine.
# Local dev: 127.0.0.1 (default). docker-compose overrides to 0.0.0.0.
# Enforced from PR2.
EXECUTION_BIND_HOST=127.0.0.1

# Bearer token for all mutating endpoints on execution-engine.
# Generate with: openssl rand -hex 32
# REQUIRED (min 32 chars) when IBKR_ENVIRONMENT=live or TRADING_ENABLED=true.
# Enforced from PR2.
#
# Phase 1 (ADR-001): the SAME value is consumed by every internal client
# (execution-engine, signal-engine, llm-agent, ui) via this single variable.
# Per-client tokens require multi-token server support and are deferred to
# a later phase.
EXECUTION_API_TOKEN=

# Feature flag: allow orderType='MKT'. Default off. Enforced from PR5.
# Accepts strictly 'true' or 'false' (any other value = config error).
EXECUTION_ALLOW_MKT=false

# Feature flag: allow POST /execution/execute-ticket with persist=false.
# UNSAFE — every use emits SAFETY:DIRECT_TICKET_USED (severity=CRITICAL)
# to system_alerts and Telegram. Enforced from PR4.
# Accepts strictly 'true' or 'false'.
EXECUTION_ALLOW_DIRECT_TICKET=false

# Max age of the last reconciliation for /ready to return 200 (seconds).
# Enforced from PR3.
EXECUTION_READY_RECONCILIATION_MAX_AGE_S=900

# Override for the SQL migrations directory (PR14.2). Leave empty for
# the default (walk up from the compiled/source module to find
# `infra/sql/migrations`; falls back to `<cwd>/infra/sql/migrations`).
# Set explicitly in containerised or non-standard layouts.
EXECUTION_MIGRATIONS_DIR=

# ----------------------------------------------------------------------------
# PR15 — Durable reconciliation & recovery
# ----------------------------------------------------------------------------
# Master switch for the reconciliation scheduler. Routes stay available
# even when this is false so operators can trigger a run manually.
RECONCILIATION_LOOP_ENABLED=true
# Base tick interval. Floored by RECONCILIATION_MIN_INTERVAL_MS.
RECONCILIATION_INTERVAL_MS=60000
# Delay before the first tick after startup.
RECONCILIATION_STARTUP_DELAY_MS=2000
# Minimum interval between ticks (safety floor).
RECONCILIATION_MIN_INTERVAL_MS=15000
# Per-source read timeout inside one reconciliation tick.
RECONCILIATION_SOURCE_TIMEOUT_MS=8000
# Hard cap on a single reconciliation run. Exceeding this flips the
# RUNNING row to ABANDONED and cancels every pending broker listener.
RECONCILIATION_RUN_TIMEOUT_MS=45000
# Safety margin added when computing the reqExecutions windowStart.
RECONCILIATION_EXECUTION_SAFETY_MARGIN_MS=300000
# Secondary token required by POST /execution/reconciliation/holds/:id/resolve.
# MUST differ from EXECUTION_API_TOKEN. If empty the endpoint returns 403.
EXECUTION_RECONCILIATION_RESOLVE_TOKEN=

# ----------------------------------------------------------------------------
# Signal engine
# ----------------------------------------------------------------------------
SIGNAL_PORT=3102
SIGNAL_EXECUTION_BASE_URL=http://localhost:3103
SIGNAL_MIN_CANDLES=220
SIGNAL_MAX_MARKET_STATE_AGE_MS=45000
# Risk + exposure caps (percent values; 200 = 2x equity, used for leveraged backtests)
SIGNAL_MAX_RISK_PER_TRADE_PCT=1
SIGNAL_MAX_EXPOSURE_PCT=100
MAX_NOTIONAL_PER_TRADE_PCT=20
SIGNAL_MAX_OPEN_POSITIONS=5
SIGNAL_MAX_SPREAD_BPS=35
SIGNAL_MIN_CANDLE_VOLUME_1M=100
SIGNAL_MIN_CONFIDENCE=0.55
# Symbols allowed to trade fractional shares (must be IBKR-fractional-eligible).
# Keep narrow: WSE/LSE and most leveraged ETFs do NOT support fractional.
SIGNAL_FRACTIONAL_SYMBOLS=
SIGNAL_FRACTIONAL_QUANTITY_STEP=0.0001
# Cooldown after a strategy emits a signal for the same symbol (ms).
SIGNAL_STRATEGY_COOLDOWN_MS=21600000
# Optional price-multiplier overrides (IBKR returns SPOL in pence/100; map to base unit).
# Format: SYMBOL:multiplier;SYMBOL:multiplier
# Example: SPOL:0.01
SIGNAL_PRICE_MULTIPLIER_OVERRIDES=
# Retention for terminal-status proposed_orders (REJECTED/EXPIRED/CANCELLED).
# Set to 0 to disable auto-deletion.
SIGNAL_REJECTED_RETENTION_DAYS=7
SIGNAL_REJECTED_CLEANUP_INTERVAL_MS=21600000
# Optional manual override of account equity (mostly for backtest). If unset, live equity is read from execution API.
# SIGNAL_ACCOUNT_EQUITY=100000

# ----------------------------------------------------------------------------
# Backtest engine
# ----------------------------------------------------------------------------
BACKTEST_PORT=3104
BACKTEST_POSTGRES_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
BACKTEST_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/ikbr_trader_backtest
# PR15.5C immutable research database. The importer rejects every other name.
BACKTEST_RESEARCH_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/ikbr_trader_backtest_pr15_5a
# Set only after the Stage-A implementation commit is green in CI.
BACKTEST_RESEARCH_IMPLEMENTATION_SHA=
BACKTEST_INGESTION_CLIENT_ID=104
BACKTEST_COMMISSION_BPS=5
BACKTEST_SYNTHETIC_SPREAD_BPS=2
BACKTEST_ORDER_TTL_CANDLES=2
# Required for FUT backtests. No implicit contract economics are provided.
# Example shape only; set commission/slippage explicitly for each experiment.
BACKTEST_FUTURES_SPECS_JSON=
# Versioned CME coverage/closure tables keyed by calendarVersion; required for FUT runs.
BACKTEST_FUTURES_CALENDARS_JSON=
BACKTEST_STRATEGY_LAB_CONCURRENCY=4
# Historical-data fetch tuning for the IB Gateway. Keep concurrency low; pacing must respect IB's 60-req/10min limit per account.
BACKTEST_HISTORY_CONCURRENCY=2
BACKTEST_HISTORY_PACING_PER_10MIN=50
# Dedicated read-only client id used by PR15.5C.1 ES inventory/acquisition.
IBKR_ES_ACQUISITION_CLIENT_ID=91551

# ----------------------------------------------------------------------------
# LLM agent (autonomous EXECUTE/REJECT gate on PROPOSED orders)
# ----------------------------------------------------------------------------
LLM_AGENT_EXECUTION_BASE_URL=http://localhost:3103
LLM_AGENT_ENABLED=true
LLM_AGENT_POLL_MS=1500
LLM_AGENT_CLAIM_STALE_MS=120000
LLM_AGENT_SYMBOL_COOLDOWN_MS=120000
LLM_AGENT_NEWS_WINDOW_HOURS=24
LLM_AGENT_FAIL_CLOSED=true
LLM_AGENT_MODEL=gpt-5-mini
LLM_AGENT_PROMPT_VERSION=llm_agent_v1
LLM_AGENT_HTTP_TIMEOUT_MS=60000
LLM_AGENT_MAX_NEWS_ITEMS=12
LLM_AGENT_OPENAI_API_KEY=
LLM_AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_AGENT_MARKETAUX_API_KEY=
LLM_AGENT_MARKETAUX_BASE_URL=https://api.marketaux.com/v1/news/all

# ----------------------------------------------------------------------------
# UI (dev server)
# ----------------------------------------------------------------------------
UI_HOST=127.0.0.1
UI_PORT=5173
UI_INGESTION_PROXY_TARGET=http://127.0.0.1:3101
UI_SIGNAL_PROXY_TARGET=http://127.0.0.1:3102
UI_EXECUTION_PROXY_TARGET=http://127.0.0.1:3103
UI_BACKTEST_PROXY_TARGET=http://127.0.0.1:3104

# ----------------------------------------------------------------------------
# PR12/PR13 — Signal-engine runtime & execution runtime
# All write / runtime / loop flags default to FALSE. Enabling requires
# EXECUTION_API_TOKEN (>=32 chars). Live trading is impossible via config:
# EXECUTION_RUNTIME_EXPECTED_ENVIRONMENT is a hard-coded literal "paper".
# ----------------------------------------------------------------------------
RUNTIME_ENABLED=false
MARKET_CONTEXT_MAX_TICK_AGE_S=30
INSTRUMENT_CONTRACT_CACHE_TTL_S=60

EXECUTION_RUNTIME_ENABLED=false
EXECUTION_RUNTIME_ENGINE_URL=
EXECUTION_RUNTIME_EXPECTED_ENVIRONMENT=paper
EXECUTION_RUNTIME_REQUEST_TIMEOUT_MS=5000

# ----------------------------------------------------------------------------
# PR14 — Paper trading loop (signal-engine)
# Loop is OFF by default. Requires EXECUTION_RUNTIME_ENABLED=true AND
# TRADING_LOOP_ENABLED=true AND EXECUTION_API_TOKEN configured.
# ----------------------------------------------------------------------------
TRADING_LOOP_ENABLED=false
TRADING_LOOP_INTERVAL_MS=30000
TRADING_LOOP_STARTUP_DELAY_MS=1000
TRADING_LOOP_MAX_CONCURRENT_INSTRUMENTS=2
TRADING_LOOP_INSTRUMENT_IDS=
TRADING_LOOP_SHUTDOWN_TIMEOUT_MS=10000
TRADING_LOOP_EXPOSURE_TIMEOUT_MS=3000

# ----------------------------------------------------------------------------
# PR15.2 — Authoritative instrument binding (shared)
# ----------------------------------------------------------------------------
# Same JSON payload is read by ingestion, signal-engine, and
# execution-engine. Each service builds its OWN authority so no
# service trusts a claim propagated by another. Empty / missing
# means no bound instruments: legacy proposal / llm-agent path
# continues unchanged, but the Phase 2 write endpoint
# (POST /execution/execute-ticket) will REFUSE every submission
# with INSTRUMENT_BINDING_UNAVAILABLE.
#
# Format (JSON array):
#   [{
#     "instrumentId": "es_front",       # must exist in InstrumentRegistry
#     "conId": 123456789,                # positive safe integer, IBKR-assigned
#     "localSymbol": "ESU6",             # dated contract
#     "tradingClass": "ES",              # MUST match registry tradingClass
#     "exchange": "CME",                 # MUST match registry exchange
#     "currency": "USD",                 # MUST match registry currency
#     "minTick": 0.25                    # PR15.2 hostile-review fix:
#                                        # positive finite; ingestion
#                                        # cross-checks against IBKR
#                                        # contractDetails.minTick, and
#                                        # execution-engine cross-checks
#                                        # against
#                                        # Instrument.executionPolicy.priceTickSize
#   }]
#
# NEVER commit a real dated conId here — the example below is
# a placeholder. Rotate via env / secret manager, then restart
# the affected services. Hot reload is intentionally NOT
# supported.
INSTRUMENT_BINDINGS_JSON=

# ----------------------------------------------------------------------------
# PR14 — Execution-engine broker-position snapshot guard
# ----------------------------------------------------------------------------
# Display cache TTL for GET /execution/account/summary (UI-facing).
EXECUTION_POSITION_MAX_AGE_S=60
# Authoritative write-path exposure guard freshness (short by design).
EXECUTION_POSITION_GUARD_MAX_AGE_S=10

# Bound entry AI gate: fresh live quote and deterministic USD stock risk caps.
EXECUTION_INGESTION_BASE_URL=http://localhost:3101
EXECUTION_AI_MAX_NOTIONAL_PCT=10
EXECUTION_AI_MAX_STOP_RISK_PCT=0.5
EXECUTION_AI_MAX_EXPOSURE_PCT=25
# GPW currency-risk foundation only; no PLN instrument is enabled.
EXECUTION_AI_MAX_NOTIONAL_PLN=500
EXECUTION_AI_MAX_STOP_RISK_PLN=5
EXECUTION_AI_FEE_RESERVE_PLN=30

# Optional: set UTC only when broker execution timestamps without a zone are UTC.
# Unset rejects zone-less timestamps for lifecycle ownership evidence.
EXECUTION_BROKER_TIME_ZONE=
