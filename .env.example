# ----------------------------------------------------------------------------
# Shared
# ----------------------------------------------------------------------------
LOG_LEVEL=info
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/ikbr_trader
REDIS_URL=redis://localhost:6379

# Telegram alerts (optional). Leave empty to disable.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_MIN_SEVERITY=info

# ----------------------------------------------------------------------------
# Shared IBKR / contract defaults
# ----------------------------------------------------------------------------
IB_SOCKET_HOST=127.0.0.1
# 4002 = IB Gateway paper, 4001 = IB Gateway live, 7497/7496 = TWS paper/live
IB_SOCKET_PORT=4002
IB_EXCHANGE=SMART
IB_CURRENCY=USD
# 1 = live, 2 = frozen, 3 = delayed, 4 = delayed frozen
IB_MARKET_DATA_TYPE=3

# ----------------------------------------------------------------------------
# Shared watchlist
# ----------------------------------------------------------------------------
WATCHLIST_SYMBOLS=AAPL,MSFT,SPY
# Optional per-symbol contract overrides used as resolve hints/fallbacks.
# Format: SYMBOL:key=value|key=value;SYMBOL:key=value
# Supported keys: conid,secType,exchange,primaryExchange,currency
# Example for LSE ETF + WSE stock:
# WATCHLIST_CONTRACT_OVERRIDES=CSPX:conid=76023663|secType=STK|exchange=SMART|primaryExchange=LSEETF|currency=USD;PZU:conid=75960216|secType=STK|exchange=WSE|primaryExchange=WSE|currency=PLN
WATCHLIST_CONTRACT_OVERRIDES=

# ----------------------------------------------------------------------------
# Ingestion
# ----------------------------------------------------------------------------
INGESTION_PORT=3101
INGESTION_CLIENT_ID=101
INGESTION_BACKFILL_1M_CANDLES=220
INGESTION_SIGNAL_ENGINE_BASE_URL=http://localhost:3102

# ----------------------------------------------------------------------------
# Execution engine
# ----------------------------------------------------------------------------
EXECUTION_PORT=3103
EXECUTION_CLIENT_ID=102
EXECUTION_DEFAULT_TIF=DAY
EXECUTION_ORDER_TIMEOUT_MS=45000
# 0 disables auto-cancel; otherwise auto-cancel SUBMITTED/PRESUBMITTED after N ms.
EXECUTION_SUBMITTED_AUTO_CANCEL_MS=120000
# Retry once as MKT when broker rejects LMT with code=110 (min price variation).
EXECUTION_RETRY_AS_MKT_ON_CODE_110=true
# Daily realized loss kill-switch (% of starting equity). 0 disables.
EXECUTION_MAX_DAILY_LOSS_PCT=10

# ----------------------------------------------------------------------------
# Signal engine
# ----------------------------------------------------------------------------
SIGNAL_PORT=3102
SIGNAL_EXECUTION_BASE_URL=http://localhost:3103
SIGNAL_MIN_CANDLES=220
SIGNAL_MAX_MARKET_STATE_AGE_MS=45000
# Risk + exposure caps (percent values; 200 = 2x equity, used for leveraged backtests)
SIGNAL_MAX_RISK_PER_TRADE_PCT=1
SIGNAL_MAX_EXPOSURE_PCT=100
MAX_NOTIONAL_PER_TRADE_PCT=20
SIGNAL_MAX_OPEN_POSITIONS=5
SIGNAL_MAX_SPREAD_BPS=35
SIGNAL_MIN_CANDLE_VOLUME_1M=100
SIGNAL_MIN_CONFIDENCE=0.55
# Symbols allowed to trade fractional shares (must be IBKR-fractional-eligible).
# Keep narrow: WSE/LSE and most leveraged ETFs do NOT support fractional.
SIGNAL_FRACTIONAL_SYMBOLS=
SIGNAL_FRACTIONAL_QUANTITY_STEP=0.0001
# Cooldown after a strategy emits a signal for the same symbol (ms).
SIGNAL_STRATEGY_COOLDOWN_MS=21600000
# Optional price-multiplier overrides (IBKR returns SPOL in pence/100; map to base unit).
# Format: SYMBOL:multiplier;SYMBOL:multiplier
# Example: SPOL:0.01
SIGNAL_PRICE_MULTIPLIER_OVERRIDES=
# Retention for terminal-status proposed_orders (REJECTED/EXPIRED/CANCELLED).
# Set to 0 to disable auto-deletion.
SIGNAL_REJECTED_RETENTION_DAYS=7
SIGNAL_REJECTED_CLEANUP_INTERVAL_MS=21600000
# Optional manual override of account equity (mostly for backtest). If unset, live equity is read from execution API.
# SIGNAL_ACCOUNT_EQUITY=100000

# ----------------------------------------------------------------------------
# Backtest engine
# ----------------------------------------------------------------------------
BACKTEST_PORT=3104
BACKTEST_POSTGRES_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
BACKTEST_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/ikbr_trader_backtest
BACKTEST_INGESTION_CLIENT_ID=104
BACKTEST_COMMISSION_BPS=5
BACKTEST_SYNTHETIC_SPREAD_BPS=2
BACKTEST_ORDER_TTL_CANDLES=2
BACKTEST_STRATEGY_LAB_CONCURRENCY=4
# Historical-data fetch tuning for the IB Gateway. Keep concurrency low; pacing must respect IB's 60-req/10min limit per account.
BACKTEST_HISTORY_CONCURRENCY=2
BACKTEST_HISTORY_PACING_PER_10MIN=50

# ----------------------------------------------------------------------------
# LLM agent (autonomous EXECUTE/REJECT gate on PROPOSED orders)
# ----------------------------------------------------------------------------
LLM_AGENT_EXECUTION_BASE_URL=http://localhost:3103
LLM_AGENT_ENABLED=true
LLM_AGENT_POLL_MS=1500
LLM_AGENT_CLAIM_STALE_MS=120000
LLM_AGENT_SYMBOL_COOLDOWN_MS=120000
LLM_AGENT_NEWS_WINDOW_HOURS=24
LLM_AGENT_FAIL_CLOSED=true
LLM_AGENT_MODEL=gpt-5-mini
LLM_AGENT_PROMPT_VERSION=llm_agent_v1
LLM_AGENT_HTTP_TIMEOUT_MS=60000
LLM_AGENT_MAX_NEWS_ITEMS=12
LLM_AGENT_OPENAI_API_KEY=
LLM_AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_AGENT_MARKETAUX_API_KEY=
LLM_AGENT_MARKETAUX_BASE_URL=https://api.marketaux.com/v1/news/all

# ----------------------------------------------------------------------------
# UI (dev server)
# ----------------------------------------------------------------------------
UI_HOST=127.0.0.1
UI_PORT=5173
UI_INGESTION_PROXY_TARGET=http://127.0.0.1:3101
UI_SIGNAL_PROXY_TARGET=http://127.0.0.1:3102
UI_EXECUTION_PROXY_TARGET=http://127.0.0.1:3103
UI_BACKTEST_PROXY_TARGET=http://127.0.0.1:3104
