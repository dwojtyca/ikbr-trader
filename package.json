{
  "name": "ikbr-trader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "pretypecheck": "pnpm --filter @ikbr/shared build && pnpm --filter @ikbr/signal-engine build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @ikbr/execution-engine test",
    "lint": "eslint .",
    "paper:verify-stack": "pnpm --filter @ikbr/paper-verify-stack start",
    "paper:verify-stack:fixture": "pnpm --filter @ikbr/paper-verify-stack verify:fixture",
    "dev:ingestion": "pnpm --filter @ikbr/ingestion dev",
    "dev:signal": "pnpm --filter @ikbr/signal-engine dev",
    "dev:execution": "pnpm --filter @ikbr/execution-engine dev",
    "dev:llm": "pnpm --filter @ikbr/llm-agent dev",
    "dev:backtest": "pnpm --filter @ikbr/backtest-engine dev",
    "dev:ui": "pnpm --filter @ikbr/ui dev"
  },
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "typescript-eslint": "^8"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.6",
      "find-my-way": "9.7.0"
    }
  }
}
