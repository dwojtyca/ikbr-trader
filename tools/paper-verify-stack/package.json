{
  "name": "@ikbr/paper-verify-stack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "paper-verify-stack": "src/index.ts"
  },
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "verify": "node --import tsx src/index.ts",
    "verify:fixture": "node --import tsx src/fixture/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^3.23"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
