{
  "name": "@ikbr/backtest-engine",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "research:import": "tsx src/research-dataset-cli.ts",
    "research:ibkr-es": "tsx src/ibkr-es-acquisition-cli.ts",
    "research:v2-preflight": "tsx src/research-v2-preflight-cli.ts",
    "research:v3-benchmark": "tsx src/research-v3-benchmark-cli.ts",
    "test": "BACKTEST_UNIT_ONLY=1 node --import tsx --test 'src/**/*.test.ts'",
    "test:integration": "node --import tsx --test 'src/**/*.pg-integration.test.ts'"
  },
  "dependencies": {
    "@ikbr/shared": "workspace:*",
    "@ikbr/signal-engine": "workspace:*",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "ib": "^0.2.8",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
