{
  "name": "@ikbr/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview --config vite.config.ts",
    "test": "node --import tsx --test 'server/**/*.test.ts' 'src/**/*.test.ts' 'src/**/*.test.tsx'"
  },
  "dependencies": {
    "@ikbr/shared": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "6.4.3",
    "tsx": "^4.19.1",
    "@types/node": "^22.7.4"
  }
}
