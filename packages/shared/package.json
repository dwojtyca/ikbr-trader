{
  "name": "@ikbr/shared",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client-order-hash": {
      "types": "./dist/client-order-hash.d.ts",
      "default": "./dist/client-order-hash.js"
    },
    "./http-auth": {
      "types": "./dist/http-auth.d.ts",
      "default": "./dist/http-auth.js"
    },
    "./instrument-research": {
      "types": "./dist/instrument-research.d.ts",
      "default": "./dist/instrument-research.js"
    },
    "./instrument-research-testfixture": {
      "types": "./dist/instrument-research/research.fixture.d.ts",
      "default": "./dist/instrument-research/research.fixture.js"
    },
    "./trading-config": {
      "types": "./dist/trading-config.d.ts",
      "default": "./dist/trading-config.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "default": "./dist/diagnostics.js"
    },
    "./accounting-owner-recovery": {
      "types": "./dist/accounting-owner-recovery.d.ts",
      "default": "./dist/accounting-owner-recovery.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "test:integration": "node --import tsx --test src/instrument-research/marketaux-hourly-hostile.pg.test.ts src/instrument-research/marketaux-hourly-state.pg.test.ts src/instrument-research/startup-recovery.pg.test.ts src/instrument-research/startup-recovery-wsh.pg.test.ts src/instrument-research/wsh-hourly.pg.test.ts src/instrument-research/wsh-recovery.pg.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
